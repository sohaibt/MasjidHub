NEXT_PUBLIC_SHEETS_API_KEY=your_google_sheets_api_key_here
NEXT_PUBLIC_SHEETS_ID=your_google_sheet_id_here

# Public URL of the deployed site, without a trailing slash.
# Used for sitemap.xml, robots.txt and the schema.org structured data that lets
# search engines show your events as rich results. Leave unset and these fall
# back to the placeholder in masjid.config.ts.
NEXT_PUBLIC_SITE_URL=https://your-masjid.org
